---
import Base from '../layouts/Base.astro';
import Arrow from '../components/Arrow.astro';
import InquiryForm from '../components/InquiryForm';
import {url,services,values,markets} from '../lib/site';
---
<Base title="Telecommunications Infrastructure Services">
  <section id="home" class="field-hero" aria-labelledby="hero-title">
    <img class="hero-photo" src={url('media/fiber-installation.webp')} alt="Cable plow and orange conduit at a rural fiber installation demonstration." width="1399" height="933" fetchpriority="high"/>
    <div class="hero-overlay"></div>
    <div class="wrap hero-content">
      <p class="eyebrow">ZANEMA · TELECOMMUNICATIONS INFRASTRUCTURE</p>
      <h1 id="hero-title">The work behind<br/>every connection.</h1>
      <p class="hero-description">Underground fiber. Aerial service. Connections that reach further.</p>
      <a href="#services" class="action action-white">Explore our capabilities <Arrow/></a>
    </div>
    <div class="wrap hero-bottom"><a href="#image-credits">Industry reference photography · USDA</a><a href="#about">Discover Zanema <span aria-hidden="true">↓</span></a></div>
  </section>
  <section id="about" class="wrap section introduction rise">
    <div><p class="eyebrow">A FIELD-SERVICES PARTNER</p><h2>Built around people.<br/>Focused on the work.</h2></div>
    <div class="intro-copy"><p>Zanema brings telecommunications field experience to the routes, installations, and connections that communities rely on.</p><p>Based in Plano, Texas, we support projects across multiple U.S. markets—with clear scope, practical coordination, and respect for the people doing the work.</p><a class="text-link" href="#markets">See our markets <Arrow/></a></div>
  </section>
  <section id="our-work" class="people-banner rise" aria-labelledby="people-title">
    <figure><img src={url('media/fiber-detail.webp')} alt="An orange fiber conduit being pulled into the ground by a cable plow." width="1100" height="734" loading="lazy"/><figcaption><a href="#image-credits">Industry reference · Not a Zanema project</a></figcaption></figure>
    <div id="values" class="people-copy"><p class="eyebrow">WHAT WE STAND FOR</p><h2 id="people-title">Good work starts<br/>with good people.</h2><p>How we work matters as much as what we build.</p><div class="principles">{values.map(v=><div><h3>{v.title}</h3><p>{v.text}</p></div>)}</div></div>
  </section>
  <section id="services" class="wrap section capabilities rise">
    <div class="capability-intro"><p class="eyebrow">OUR CAPABILITIES</p><h2>From the route<br/>to the connection.</h2><p>Specialized field support for telecommunications projects.</p><a href="#contact" class="text-link">Discuss your scope <Arrow/></a></div>
    <div class="capability-list">{services.map((s,i)=><article class="capability" id={`service-${s.slug}`}><span class="capability-number">0{i+1}</span><div><h3>{s.title}</h3><p>{s.description}</p><ul>{s.scope.map(item=><li>{item}</li>)}</ul></div><Arrow diagonal/></article>)}<p class="small-note">Scope, qualifications, and crew availability are confirmed for each project.</p></div>
  </section>
  <section id="markets" class="market-section rise"><div class="wrap section market-layout"><div><p class="eyebrow">OUR FOOTPRINT</p><h2>Rooted in Texas.<br/>Working across markets.</h2><p>Local understanding, with experience across state lines.</p><ul class="market-list">{markets.map(m=><li>{m.name}</li>)}</ul><p class="small-note">Markets reflect operating experience, not permanent offices or immediate crew availability.</p></div><figure><img src={url('media/us-footprint.svg')} alt="Map highlighting Texas, Minnesota, Nebraska, North Carolina, Virginia, Louisiana and Illinois." width="840" height="480" loading="lazy"/><figcaption>Markets with operating experience</figcaption></figure></div><div class="wrap network-experience"><p>Experience involving these networks and organizations.<br/><small>No endorsement or direct contract implied.</small></p><div>Spectrum <span>T-Fiber</span> Swyft</div></div></section>
  <section id="safety-quality" class="wrap section safety-layout rise"><div><p class="eyebrow">SAFETY & QUALITY</p><h2>Responsibility.<br/>At every step.</h2></div><div class="safety-items"><article><span>01</span><h3>Understand the site</h3><p>Review access, route conditions, existing utilities, and project requirements.</p></article><article><span>02</span><h3>Coordinate before work</h3><p>Confirm utility notification and locating requirements, including 811 where applicable. White lining does not replace utility locating.</p></article><article><span>03</span><h3>Document the handoff</h3><p>Use field reporting to communicate work activity, service types, quantities, and completion.</p></article><p class="small-note">Confirm project-specific qualifications and procedures directly with Zanema. This is not a certification or safety record.</p></div></section>
  <section id="contact" class="contact-section rise"><div class="wrap section contact-layout"><div><p class="eyebrow">LET’S TALK</p><h2>Your next project.<br/>Our next conversation.</h2><p>Tell us where, what, and when.<br/>We’ll start with the scope.</p><p class="contact-location">Zanema LLC<br/>Plano, Texas · United States</p><p class="small-note">Local preview only. Prepare a draft below; nothing is sent.</p></div><InquiryForm client:visible/></div></section>
  <section id="privacy" class="wrap legal-note"><details><summary>Preview privacy & image credits</summary><h3>Privacy</h3><p>This local preview does not send inquiries, save form information, or configure analytics. Delivery, spam protection, retention, and the production privacy notice require approval. Do not enter confidential information.</p><h3 id="image-credits">Image credits</h3><p>U.S. Department of Agriculture, “Easton Utilities Fiber Optic Cable Work Demonstration,” images <a href="https://commons.wikimedia.org/wiki/File:Easton_Utilities_Fiber_Optic_Cable_Work_Demonstration_(20230920-USDA-RD-CDP-0219).jpg">0219 (hero)</a> and <a href="https://commons.wikimedia.org/wiki/File:Easton_Utilities_Fiber_Optic_Cable_Work_Demonstration_(20230920-USDA-RD-CDP-0277).jpg">0277 (detail)</a>. Public domain; resized and cropped. These illustrate industry work and are not Zanema projects or personnel.</p></details></section>
</Base>
<script>
  document.querySelectorAll('a[href="#image-credits"]').forEach(link=>link.addEventListener('click',()=>{
    document.querySelector<HTMLDetailsElement>('#privacy details')?.setAttribute('open','');
  }));
  if(location.hash==='#image-credits') document.querySelector<HTMLDetailsElement>('#privacy details')?.setAttribute('open','');
</script>
